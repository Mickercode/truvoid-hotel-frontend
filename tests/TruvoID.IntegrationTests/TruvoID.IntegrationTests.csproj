<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.*" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Hosts the real API (top-level Program) against a real Postgres, so the tests
       exercise the actual middleware, auth policies, and endpoints. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TruvoID.API\TruvoID.API.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\deploy\local\postgres-init\01-roles.sql" LogicalName="LocalInit.01-roles.sql" />
  </ItemGroup>

</Project>
