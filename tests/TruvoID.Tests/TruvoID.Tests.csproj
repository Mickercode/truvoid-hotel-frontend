<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- Link real source files from backend so tests validate the actual code -->
  <ItemGroup>
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Services\EmailTemplates.cs" Link="Services\EmailTemplates.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Services\EmailService.cs" Link="Services\EmailService.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Domain\Enums\VerificationType.cs" Link="Enums\VerificationType.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Domain\Enums\AuditAction.cs" Link="Enums\AuditAction.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Core\Interfaces\IAuditService.cs" Link="Interfaces\IAuditService.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Postgres\*.cs" Link="Postgres\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\TruvoID.API\Endpoints\AuthValidation.cs" Link="Endpoints\AuthValidation.cs" />
    <Compile Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Identity\*.cs" Link="Identity\%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Postgres\Migrations\ControlPlane\*.sql" LogicalName="ControlPlane.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\src\TruvoID.API\TruvoID.Infrastructure\Postgres\Migrations\Tenant\*.sql" LogicalName="Tenant.%(Filename)%(Extension)" />
    <!-- The real local role bootstrap, so the tests exercise the same role setup devs run -->
    <EmbeddedResource Include="..\..\deploy\local\postgres-init\01-roles.sql" LogicalName="LocalInit.01-roles.sql" />
  </ItemGroup>

</Project>
