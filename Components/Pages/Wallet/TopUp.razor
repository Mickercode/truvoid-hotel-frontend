@page "/wallet/topup"
@layout DashboardLayout
@rendermode InteractiveServer
@inject ApiClient Api
@inject NavigationManager Navigation

<AuthGuard />
<PageTitle>Add Funds — TruvoID</PageTitle>

<div class="px-margin-mobile md:px-margin-desktop py-8 md:py-12 flex-1 max-w-5xl mx-auto w-full">

    <div class="mb-section-gap">
        <h1 class="font-headline-lg text-headline-lg text-deep-navy mb-2">Replenish Balance</h1>
        <p class="font-body-md text-body-md text-slate-gray">Fund your wallet securely with Flutterwave or use a bank transfer for manual approval.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">

        <!-- Left: Input & Selection -->
        <div class="lg:col-span-8 flex flex-col gap-10">

            <!-- Amount Selection -->
            <section class="bg-paper-white p-8 rounded-lg border-t-2 border-warm-gold border border-surface-variant shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)]">
                <h3 class="font-label-sm text-label-sm text-deep-navy uppercase mb-6 tracking-widest">Select Amount</h3>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                    <button class="py-4 border rounded-lg text-center transition-all group @(_amount == 50000 ? "border-2 border-deep-navy bg-surface-bright shadow-sm" : "border-outline-variant hover:border-deep-navy hover:bg-surface")"
                            @onclick='() => SetAmount(50000)'>
                        <span class="block font-headline-md text-headline-md text-deep-navy">&#8358;50,000</span>
                        <span class="block font-label-sm text-label-sm text-slate-gray mt-1">Standard</span>
                    </button>
                    <button class="py-4 border rounded-lg text-center transition-all relative overflow-hidden @(_amount == 100000 ? "border-2 border-deep-navy bg-surface-bright shadow-sm" : "border-outline-variant hover:border-deep-navy hover:bg-surface")"
                            @onclick='() => SetAmount(100000)'>
                        @if (_amount != 100000)
                        {
                            <div class="absolute top-0 right-0 bg-deep-navy text-paper-white font-label-sm text-[9px] px-2 py-0.5 rounded-bl">POPULAR</div>
                        }
                        <span class="block font-headline-md text-headline-md text-deep-navy">&#8358;100,000</span>
                        <span class="block font-label-sm text-label-sm text-slate-gray mt-1">Recommended</span>
                    </button>
                    <button class="py-4 border rounded-lg text-center transition-all group @(_amount == 500000 ? "border-2 border-deep-navy bg-surface-bright shadow-sm" : "border-outline-variant hover:border-deep-navy hover:bg-surface")"
                            @onclick='() => SetAmount(500000)'>
                        <span class="block font-headline-md text-headline-md text-deep-navy">&#8358;500,000</span>
                        <span class="block font-label-sm text-label-sm text-slate-gray mt-1">Enterprise</span>
                    </button>
                </div>

                <div>
                    <label class="block font-label-sm text-label-sm text-deep-navy mb-2">Custom Amount (&#8358;)</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 font-body-lg text-body-lg text-slate-gray">&#8358;</span>
                        <input class="w-full pl-10 pr-4 py-3 border border-outline-variant rounded bg-transparent font-body-lg text-body-lg text-deep-navy focus:border-deep-navy focus:ring-1 focus:ring-deep-navy outline-none transition-all placeholder:text-outline-variant"
                               @bind="_amount" type="number" min="50000" step="10000" />
                    </div>
                    <p class="mt-2 font-body-sm text-body-sm text-slate-gray">Minimum deposit: &#8358;50,000</p>
                </div>
            </section>            <!-- Payment Instructions -->
                <section class="bg-paper-white p-8 rounded-lg border border-surface-variant shadow-[0_12px_32px_-4px_rgba(31,56,100,0.05)]">
                    <h3 class="font-label-sm text-label-sm text-deep-navy uppercase mb-6 tracking-widest">How to Replenish</h3>
                    <p class="font-body-sm text-body-sm text-slate-gray mb-6">
                        Choose an online checkout for immediate payment, or follow the bank transfer steps below for manual approval:
                    </p>

                    <div class="space-y-5">
                        <!-- Step 1: Bank Account -->
                        <div class="bg-surface-container-low border border-outline-variant rounded p-5">
                            <div class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-warm-gold flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-[15px] text-paper-white" style="font-variation-settings: 'FILL' 1;">account_balance</span>
                                </div>
                                <div>
                                    <p class="font-label-md text-label-md text-on-surface mb-1">Step 1: Transfer to our Bank Account</p>
                                    <div class="bg-surface-container p-4 rounded border border-outline-variant mb-3 space-y-4">
                                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Bank</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold">Zenith Bank</p>
                                            </div>
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Account Name</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold">Slogani Consults Nigeria Limited</p>
                                            </div>
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Account Number</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold font-mono">1017167544</p>
                                            </div>
                                        </div>
                                        <div class="border-t border-outline-variant pt-4 grid grid-cols-1 sm:grid-cols-3 gap-4 text-sm">
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Bank</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold">Providus Bank</p>
                                            </div>
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Account Name</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold">Slogani Consults Nigeria Limited</p>
                                            </div>
                                            <div>
                                                <p class="font-label-sm text-label-sm text-slate-gray uppercase tracking-wider">Account Number</p>
                                                <p class="font-body-md text-body-md text-on-surface font-semibold font-mono">1310418112</p>
                                            </div>
                                        </div>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-slate-gray">
                                        Transfer the exact amount shown above to either of the accounts above. Keep the transfer reference.
                                    </p>
                                </div>
                            </div>
                        </div>

                        <!-- Step 2: WhatsApp Receipt -->
                        <div class="bg-surface-container-low border border-outline-variant rounded p-5">
                            <div class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-deep-navy flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-[15px] text-paper-white" style="font-variation-settings: 'FILL' 1;">chat</span>
                                </div>
                                <div>
                                    <p class="font-label-md text-label-md text-on-surface mb-1">Step 2: Send your receipt to WhatsApp</p>
                                    <p class="font-body-sm text-body-sm text-slate-gray mb-3">
                                        Once you've made the transfer, send the payment receipt (screenshot or transfer reference) to our WhatsApp line so we can verify and credit your account:
                                    </p>
                                    <div class="bg-[#E6F4EA] border border-[#CEead6] rounded p-4 flex items-center gap-3">
                                        <span class="material-symbols-outlined text-[#137333] text-[24px]" style="font-variation-settings: 'FILL' 1;">chat</span>
                                        <div>
                                            <p class="font-label-md text-label-md text-[#137333] font-semibold">+234 800 000 0000</p>
                                            <p class="font-body-sm text-[11px] text-[#137333]">TruvoID WhatsApp Support — send your transfer receipt here</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Step 3: Confirm -->
                        <div class="bg-surface-container-low border border-outline-variant rounded p-5">
                            <div class="flex items-start gap-4">
                                <div class="w-8 h-8 rounded-full bg-[#b06000] flex items-center justify-center shrink-0 mt-0.5">
                                    <span class="material-symbols-outlined text-[15px] text-paper-white" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                </div>
                                <div>
                                    <p class="font-label-md text-label-md text-on-surface mb-1">Step 3: Click "I Have Sent the Money"</p>
                                    <p class="font-body-sm text-body-sm text-slate-gray mb-3">
                                        Once you've sent the receipt, click the button below. Our admin team will verify the payment and credit your wallet. You'll receive an email notification once your account is credited.
                                    </p>
                                     <button @onclick="HandleTopup" disabled="@(_isLoading || _amount < 50000)" class="w-full bg-warm-gold text-paper-white font-label-md text-label-md uppercase py-3 px-6 rounded hover:opacity-90 transition-opacity flex items-center justify-center gap-2 disabled:opacity-50">
                                        @if (_isLoading)
                                        {
                                            <div class="w-4 h-4 border-2 border-paper-white border-t-transparent rounded-full animate-spin"></div>
                                            <span>Submitting...</span>
                                        }
                                        else
                                        {
                                            <span class="material-symbols-outlined text-[18px]">send</span>
                                            <span>I Have Sent the Money</span>
                                        }
                                     </button>
                                    <button @onclick="HandleFlutterwave" disabled="@(_isLoading || _amount < 50000)" class="w-full mt-3 border border-deep-navy text-deep-navy font-label-md text-label-md uppercase py-3 px-6 rounded hover:bg-surface-container-low transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                                        <span class="material-symbols-outlined text-[18px]">payments</span>
                                        Pay securely with Flutterwave
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
        </div>

        <!-- Right: Summary -->
        <div class="lg:col-span-4">
            <div class="bg-surface-container-low p-6 rounded-lg border border-surface-variant sticky top-28">
                <h3 class="font-label-sm text-label-sm text-deep-navy uppercase mb-6 tracking-widest border-b border-outline-variant pb-4">Transaction Summary</h3>

                <div class="flex flex-col gap-4 mb-6 border-b border-outline-variant pb-6">
                    <div class="flex justify-between items-center">
                        <span class="font-body-md text-body-md text-slate-gray">Amount to Transfer</span>
                        <span class="font-label-md text-label-md text-deep-navy">&#8358;@_amount.ToString("N2")</span>
                    </div>
                    <div class="flex justify-between items-center">
                        <span class="font-body-md text-body-sm text-slate-gray">Processing Fee</span>
                        <span class="font-label-md text-label-md text-[#137333]">None — Bank Transfer</span>
                    </div>
                </div>

                <div class="flex justify-between items-end mb-8">
                    <span class="font-label-sm text-label-sm text-deep-navy uppercase">Total to Transfer</span>
                    <span class="font-headline-lg text-headline-lg text-deep-navy font-bold tracking-tight">&#8358;@_amount.ToString("N0")</span>
                </div>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded text-red-700 font-body-sm text-body-sm">@_errorMessage</div>
                }


            </div>
        </div>
    </div>
</div>

@code {
    private decimal _amount = 100000;
    private bool _isLoading;
    private string? _errorMessage;

    private sealed record FlutterwaveCheckoutResponse(string CheckoutUrl, string TransactionReference);

    private void SetAmount(decimal amount) => _amount = amount;

    private async Task HandleTopup()
    {
        if (_amount < 50000) return;

        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await Api.PostAsync<TopupInitiateResponse>("/v1/wallet/topup/initiate", new
            {
                amount = _amount,
                paymentProvider = "manual"
            });

            if (response?.Reference is not null)
            {
                _errorMessage = $"Top-up request submitted! Reference: {response.Reference}. Please transfer ₦{@_amount:N0} to either Zenith Bank (1017167544) or Providus Bank (1310418112) — both under Slogani Consults Nigeria Limited — and send the receipt to +234 800 000 0000 on WhatsApp. Click 'I Have Sent the Money' on the Dashboard when your account is credited.";
                StateHasChanged();
            }
            else
            {
                _errorMessage = "Failed to initiate top-up. Please try again.";
            }
        }
        catch (Exception)
        {
            _errorMessage = "Unable to connect to payment service.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task HandleFlutterwave()
    {
        if (_amount < 50000) return;
        _isLoading = true;
        _errorMessage = null;
        try
        {
            var response = await Api.PostAsync<FlutterwaveCheckoutResponse>("/v1/tenant/wallet/topups/flutterwave/initialize", new
            {
                amountNaira = _amount,
                redirectUrl = Navigation.Uri
            });
            if (string.IsNullOrWhiteSpace(response?.CheckoutUrl))
            {
                _errorMessage = "Flutterwave did not return a checkout link. Please try again.";
                return;
            }
            Navigation.NavigateTo(response.CheckoutUrl, forceLoad: true);
        }
        catch
        {
            _errorMessage = "Unable to start Flutterwave checkout. Please try again or use bank transfer.";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
