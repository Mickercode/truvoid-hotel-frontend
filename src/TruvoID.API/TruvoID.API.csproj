<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <!-- Endpoint files live here -->
    <Compile Include="Endpoints/**/*.cs" />
    <Compile Include="Auth/**/*.cs" />
  </ItemGroup>


  <ItemGroup>
    <!-- Shared core/domain/infrastructure, nested here so a Railway build scoped to
         this folder alone (Root Directory = src/TruvoID.API) is self-contained
         (exclude stale EF Migrations) -->
    <Compile Include="TruvoID.Core/**/*.cs" Link="Core/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="TruvoID.Domain/**/*.cs" Link="Domain/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="TruvoID.Infrastructure/**/*.cs" Link="Infrastructure/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Remove="TruvoID.Core/obj/**/*.cs" />
    <Compile Remove="TruvoID.Core/bin/**/*.cs" />
    <Compile Remove="TruvoID.Domain/obj/**/*.cs" />
    <Compile Remove="TruvoID.Domain/bin/**/*.cs" />
    <Compile Remove="TruvoID.Infrastructure/obj/**/*.cs" />
    <Compile Remove="TruvoID.Infrastructure/bin/**/*.cs" />
    <Compile Remove="TruvoID.Infrastructure/Migrations/**/*.cs" />
    <!-- Legacy MongoDB application is retired; only PostgreSQL tenant code ships. -->
    <Compile Remove="Endpoints/AdminApprovalEndpoints.cs" />
    <Compile Remove="Endpoints/CallHistoryEndpoints.cs" />
    <Compile Remove="Endpoints/InstitutionEndpoints.cs" />
    <Compile Remove="Endpoints/NotificationEndpoints.cs" />
    <Compile Remove="Endpoints/NotificationFeedEndpoints.cs" />
    <Compile Remove="Endpoints/OnboardingEndpoints.cs" />
    <Compile Remove="Endpoints/PasswordResetEndpoints.cs" />
    <Compile Remove="Endpoints/PricingEndpoints.cs" />
    <Compile Remove="Endpoints/VerificationEndpoints.cs" />
    <Compile Remove="Endpoints/WalletEndpoints.cs" />
    <Compile Remove="Endpoints/WalletAlertEndpoints.cs" />
    <Compile Remove="Endpoints/RegistrationEmailHook.cs" />
    <Compile Remove="TruvoID.Domain/Entities/**/*.cs" />
    <Compile Remove="TruvoID.Infrastructure/Data/**/*.cs" />
    <Compile Remove="TruvoID.Infrastructure/Extensions/**/*.cs" />
    <Compile Remove="TruvoID.Core/Interfaces/INimcConfigService.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Postgres migrations, applied by `dotnet TruvoID.API.dll migrate` / `provision-tenants` -->
    <EmbeddedResource Include="TruvoID.Infrastructure/Postgres/Migrations/ControlPlane/*.sql" LogicalName="ControlPlane.%(Filename)%(Extension)" />
    <EmbeddedResource Include="TruvoID.Infrastructure/Postgres/Migrations/Tenant/*.sql" LogicalName="Tenant.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.*" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

</Project>
